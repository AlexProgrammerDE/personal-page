{
  "name": "personal-page",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "dev": "cf dev",
    "start": "vite preview --port 3000",
    "typecheck": "bun run cf-typegen && bun run generate:routes && tsc --noEmit",
    "fix": "biome check --write --unsafe",
    "check": "biome check",
    "preview": "vite preview --port 3000",
    "deploy": "cf deploy",
    "upload": "cf build && cf workers versions create --prebuilt",
    "cf-typegen": "cf workers types",
    "build:worker": "bun run build",
    "deploy:dry-run": "bun run deploy --dry-run",
    "generate:routes": "bun scripts/generate-routes.ts",
    "postinstall": "bun run generate:routes",
    "prepare": "lefthook install",
    "pre-commit": "lefthook run pre-commit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.0.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/core": "7.0.8",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "4.2.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "motion": "^14.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@fontsource-variable/inter": "^5.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/config": "0.32.0",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "cf": "1.0.0-beta.31",
    "typescript": "6.0.3",
    "wrangler": "4.161.0",
    "@tanstack/router-generator": "^1.168.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "lefthook": "2.2.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
