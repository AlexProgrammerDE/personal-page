{
  "name": "personal-page",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "dev": "cf dev",
    "start": "vite preview --port 3000",
    "typecheck": "bun run cf-typegen && bun run generate:routes && tsc --noEmit",
    "fix": "oxlint --fix && oxfmt",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check",
    "preview": "vite preview --port 3000",
    "deploy": "cf deploy",
    "upload": "cf build && cf workers versions create --prebuilt",
    "cf-typegen": "cf workers types",
    "build:worker": "bun run build",
    "deploy:dry-run": "bun run deploy --dry-run",
    "generate:routes": "bun scripts/generate-routes.ts",
    "postinstall": "bun run generate:routes",
    "prepare": "lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "pre-commit": "lefthook run pre-commit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@icons-pack/react-simple-icons": "^13.0.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/core": "7.0.8",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "4.2.4",
    "clsx": "^2.1.1",
    "effect": "4.1.4",
    "lucide-react": "^1.0.0",
    "motion": "^14.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@cloudflare/config": "0.32.1",
    "@cloudflare/vite-plugin": "2.0.0-rc.1",
    "@effect/tsgo": "0.70.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-generator": "^1.168.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cf": "1.0.0-rc.1",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "26"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
