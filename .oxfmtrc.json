{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/globals.css",
    "functions": ["cn", "cva", "clsx", "twMerge"]
  },
  "ignorePatterns": [
    ".next",
    "dist",
    "build",
    "coverage",
    "out",
    ".source",
    "postcss.config.mjs",
    "src/routeTree.gen.ts",
    ".cloudflare",
    ".tanstack",
    ".output"
  ]
}
