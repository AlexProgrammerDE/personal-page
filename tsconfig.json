{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".cloudflare/types/index.d.ts"],
  "exclude": ["node_modules", "dist", "out", ".output", ".cloudflare/output"]
}
